# Swap local <-> Azure by changing the values below; no code changes needed.

LLM__PROVIDER=ollama
LLM__OLLAMA__BASE_URL=http://localhost:11434
LLM__OLLAMA__MODEL_FAST=llama3.1:8b
LLM__OLLAMA__MODEL_ACCURATE=llama3.1:8b
# LLM__PROVIDER=bedrock
# LLM__BEDROCK__PROFILE=dev
# LLM__BEDROCK__REGION=us-west-2
# LLM__BEDROCK__MODEL_ID=us.amazon.nova-pro-v1:0
# LLM__PROVIDER=aoai
# LLM__AOAI__ENDPOINT=https://<resource>.openai.azure.com
# LLM__AOAI__DEPLOYMENT_FAST=gpt-4o-mini
# LLM__AOAI__DEPLOYMENT_ACCURATE=gpt-4o

# EMBEDDING__PROVIDER=local_bge
# EMBEDDING__PROVIDER=bedrock
# EMBEDDING__BEDROCK__PROFILE=dev
# EMBEDDING__BEDROCK__REGION=us-west-2
# EMBEDDING__BEDROCK__MODEL_ID=amazon.titan-embed-text-v2:0
# EMBEDDING__BEDROCK__DIMENSIONS=1024
# EMBEDDING__PROVIDER=aoai
# EMBEDDING__AOAI__ENDPOINT=https://<resource>.openai.azure.com
# EMBEDDING__AOAI__DEPLOYMENT=text-embedding-3-large
EMBEDDING__PROVIDER=gemini
EMBEDDING__GEMINI__API_KEY=<your-google-ai-api-key>
EMBEDDING__GEMINI__MODEL=text-embedding-004

VECTOR_STORE__PROVIDER=qdrant
# Lean local (no Docker): embedded on-disk store via qdrant-client.
# When PATH is set, URL is ignored. ":memory:" = no disk, non-persistent.
VECTOR_STORE__QDRANT__PATH=./.qdrant
VECTOR_STORE__QDRANT__COLLECTION=sops
# Server mode (Docker / binary) instead of PATH:
# VECTOR_STORE__QDRANT__URL=http://localhost:6333
# VECTOR_STORE__PROVIDER=ai_search
# VECTOR_STORE__AI_SEARCH__ENDPOINT=https://<resource>.search.windows.net
# VECTOR_STORE__AI_SEARCH__INDEX=sops

PII__PROVIDER=presidio

SAFETY__PROVIDER=stub
# SAFETY__PROVIDER=azure
# SAFETY__AZURE__ENDPOINT=https://<resource>.cognitiveservices.azure.com

AUDIT__SINK=jsonl
AUDIT__JSONL__DIR=./audit
# AUDIT__SINK=appinsights
# AUDIT__APPINSIGHTS__CONNECTION_STRING=InstrumentationKey=...

SECRETS__PROVIDER=env
# SECRETS__PROVIDER=keyvault
# SECRETS__KEYVAULT__URI=https://<vault>.vault.azure.net

TELEMETRY__PROVIDER=console
# TELEMETRY__PROVIDER=appinsights
# TELEMETRY__APPINSIGHTS__CONNECTION_STRING=InstrumentationKey=...
# TELEMETRY__PROVIDER=langfuse
# TELEMETRY__LANGFUSE__PUBLIC_KEY=pk-lf-local
# TELEMETRY__LANGFUSE__SECRET_KEY=sk-lf-local
# TELEMETRY__LANGFUSE__HOST=http://localhost:3000

TOOLS_CLIENT__PROVIDER=http
TOOLS_CLIENT__BASE_URL=http://localhost:8001
TOOLS_CLIENT__TOKEN=dev-token
TOOLS_API_TOKEN=dev-token

PROMPT_STORE__PROVIDER=file
PROMPT_STORE__FILE__BASE_DIR=./docs
# PROMPT_STORE__PROVIDER=promptflow
# PROMPT_STORE__PROMPTFLOW__WORKSPACE=<workspace>

# RERANKER__PROVIDER=sentence_transformers
# RERANKER__MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Loan + SOP source (independent switches) ───────────────────────────────
# DATA__LOAN_SOURCE=mock          # fixtures (data/fixtures/loan_api) or data/loans.json
# DATA__LOAN_SOURCE=real          # PennyMac Loan Services API
# DATA__SOP_SOURCE=local          # synthetic data/sops only
# DATA__SOP_SOURCE=confluence     # Confluence SOPs only
# DATA__SOP_SOURCE=both           # synthetic + Confluence
# DATA__SOP_CONFLUENCE_MODE=cache # read data/sops/_confluence (offline)
# DATA__SOP_CONFLUENCE_MODE=live  # fetch Confluence REST + refresh cache
# Demo mix (fixtures + Confluence-only cache):
DATA__LOAN_SOURCE=mock
DATA__SOP_SOURCE=confluence
DATA__SOP_CONFLUENCE_MODE=cache
# Deprecated unified switch (loan_source; real → sop both+live):
# DATA__MODE=mock
