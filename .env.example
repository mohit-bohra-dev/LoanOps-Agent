# Swap local <-> Azure by changing the values below; no code changes needed.

LLM__PROVIDER=ollama
LLM__OLLAMA__BASE_URL=http://localhost:11434
LLM__OLLAMA__MODEL_FAST=llama3.1:8b
LLM__OLLAMA__MODEL_ACCURATE=llama3.1:8b
# LLM__PROVIDER=bedrock
# LLM__BEDROCK__PROFILE=dev
# LLM__BEDROCK__REGION=us-west-2
# LLM__BEDROCK__MODEL_ID=us.amazon.nova-pro-v1:0
# LLM__PROVIDER=aoai
# LLM__AOAI__ENDPOINT=https://<resource>.openai.azure.com
# LLM__AOAI__DEPLOYMENT_FAST=gpt-4o-mini
# LLM__AOAI__DEPLOYMENT_ACCURATE=gpt-4o

# EMBEDDING__PROVIDER=local_bge
# EMBEDDING__PROVIDER=bedrock
# EMBEDDING__BEDROCK__PROFILE=dev
# EMBEDDING__BEDROCK__REGION=us-west-2
# EMBEDDING__BEDROCK__MODEL_ID=amazon.titan-embed-text-v2:0
# EMBEDDING__BEDROCK__DIMENSIONS=1024
# EMBEDDING__PROVIDER=aoai
# EMBEDDING__AOAI__ENDPOINT=https://<resource>.openai.azure.com
# EMBEDDING__AOAI__DEPLOYMENT=text-embedding-3-large
EMBEDDING__PROVIDER=gemini
EMBEDDING__GEMINI__API_KEY=<your-google-ai-api-key>
EMBEDDING__GEMINI__MODEL=text-embedding-004

VECTOR_STORE__PROVIDER=qdrant
# Lean local (no Docker): embedded on-disk store via qdrant-client.
# When PATH is set, URL is ignored. ":memory:" = no disk, non-persistent.
VECTOR_STORE__QDRANT__PATH=./.qdrant
VECTOR_STORE__QDRANT__COLLECTION=sops
# Server mode (Docker / binary) instead of PATH:
# VECTOR_STORE__QDRANT__URL=http://localhost:6333
# VECTOR_STORE__PROVIDER=ai_search
# VECTOR_STORE__AI_SEARCH__ENDPOINT=https://<resource>.search.windows.net
# VECTOR_STORE__AI_SEARCH__INDEX=sops

PII__PROVIDER=presidio

SAFETY__PROVIDER=stub
# SAFETY__PROVIDER=azure
# SAFETY__AZURE__ENDPOINT=https://<resource>.cognitiveservices.azure.com

AUDIT__SINK=jsonl
AUDIT__JSONL__DIR=./audit
# AUDIT__SINK=appinsights
# AUDIT__APPINSIGHTS__CONNECTION_STRING=InstrumentationKey=...

SECRETS__PROVIDER=env
# SECRETS__PROVIDER=keyvault
# SECRETS__KEYVAULT__URI=https://<vault>.vault.azure.net

TELEMETRY__PROVIDER=console
# TELEMETRY__PROVIDER=appinsights
# TELEMETRY__APPINSIGHTS__CONNECTION_STRING=InstrumentationKey=...
# TELEMETRY__PROVIDER=langfuse
# TELEMETRY__LANGFUSE__PUBLIC_KEY=pk-lf-local
# TELEMETRY__LANGFUSE__SECRET_KEY=sk-lf-local
# TELEMETRY__LANGFUSE__HOST=http://localhost:3000

TOOLS_CLIENT__PROVIDER=modular
# TOOLS_CLIENT__PROVIDER=mcp   # agent hop via packages.mcp_server (ADR-013); keep modular for make demo
AGENT_ROLE=system

# Streamable HTTP MCP listener (python -m packages.mcp_server). Required when TOOLS_CLIENT__PROVIDER=mcp.
# MCP__HOST=127.0.0.1
# MCP__PORT=8001
# MCP__PATH=/mcp
# MCP__AUTH_TOKEN=
# MCP__ROLE=system
# MCP__PRINCIPAL_USER=   # optional; forwarded as x-loanops-user on call_sse_api
# MCP__PRINCIPAL_TENANT= # optional; forwarded as x-loanops-tenant

# RDF Capability Knowledge Graph (ADR-014). Offline build: python -m packages.capability_kg.build
# CAPABILITY_KG__ENABLED=true
# CAPABILITY_KG__NAMESPACE=https://loanops.local/ontology/
# CAPABILITY_KG__TTL_PATH=data/capability_kg/capabilities.ttl  # deprecated; build CLI only
# CAPABILITY_KG__APPROVED_ONLY=false
# CAPABILITY_KG__SEMANTIC=false  # Phase 9: cosine over embeddings sidecar if present
# CAPABILITY_KG__REQUIRE_CAPABILITY_BIND=false  # true = call_sse_api must pass capability_id
# CAPABILITY_KG__ENFORCE_PERMISSIONS=false  # true = requiresPermission checked at MCP
# CAPABILITY_KG__ALLOWED_PERMISSIONS=[]  # empty = role defaults (system/dev: loan.read)
# Product discovery uses EAKG shards under EAKG__SHARD_DIR/repos (no single-TTL fallback).
# Set CAPABILITY_KG__ENABLED=false to turn graph discovery off without code changes.
# Enterprise Application Knowledge Graph (ADR-015..019)
# EAKG__WORKSPACE_DIR=.eakg-workspace
# EAKG__REGISTRY_PATH=data/eakg/registry/repositories.yaml
# EAKG__SHARD_DIR=data/eakg
# EAKG__GITLAB_HOST=gitlab.pnmac.com
# EAKG__OPENAPI_MODE=hybrid
# EAKG__LIVE_SPEC_TOKEN=
# EAKG__CONFIDENCE_THRESHOLD=0.85
# EAKG__AUTO_APPROVE_STRUCTURAL=true
# EAKG__NIGHTLY_HOUR=2
# EAKG__REVIEW_STALE_DAYS=14
# EAKG__TAAC_FIXTURE_PATH=data/eakg/fixtures/taac-client-config.redacted.json
# EAKG__EXTRACTOR=auto  # auto|roslyn|regex — Roslyn primary (D5); regex interim fallback
# EAKG__TAAC_CONFIG_PATH=

# SSE OpenAPI — sole answer path. Add all SSE apps here (10+).
SSE__USE_FIXTURE=true
SSE__API_BASE_URL=https://corecomponentsapi.dev.pennymac.plaisse.com
# SSE__API_KEY=
# D7: SubservicingClient Auth0 M2M Bearer (audience https://pennymac).
# Refresh (manual): .\scripts\auth\refresh-sse-m2m.ps1
# Optional probe: .\scripts\auth\refresh-sse-m2m.ps1 -ProbeUrl "https://loanservicesapi-plaisse-dev.pnmac.com/api/Loans/1000002245/Summary"
# Secret lives in SubservicingClient user-secrets (Auth0M2M:ClientSecret). Do not commit.
# SSE__USE_FIXTURE=false
# SSE__SWAGGER_LINKS=[{"id":"pennedocs","label":"PennEDocs","url":"https://pennedocsapi.dev.pennymac.plaisse.com/swagger/v1/swagger.json"},{"id":"corecomponents","label":"CoreComponents","url":"https://corecomponentsapi.dev.pennymac.plaisse.com/swagger/v1/swagger.json"}]
# SSE__SWAGGER_URLS=["https://pennedocsapi.dev.pennymac.plaisse.com/swagger/v1/swagger.json"]

# SQL Server (packages.db) — needs ODBC Driver 18 + aioodbc when fixture_mode=false
SQL_SERVER__FIXTURE_MODE=true
# SQL_SERVER__SERVER=
# SQL_SERVER__DATABASE=
# SQL_SERVER__USER=
# SQL_SERVER__PASSWORD=

# Session store: memory (default) or postgres (durable wiki-style threads)
SESSION_STORE__PROVIDER=memory

PROMPT_STORE__PROVIDER=file
PROMPT_STORE__FILE__BASE_DIR=./docs
# PROMPT_STORE__PROVIDER=promptflow
# PROMPT_STORE__PROMPTFLOW__WORKSPACE=<workspace>

# RERANKER__PROVIDER=sentence_transformers
# RERANKER__MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Loan + SOP source (independent switches) ───────────────────────────────
# DATA__LOAN_SOURCE=mock          # fixtures (data/fixtures/loan_api) or data/loans.json
# DATA__LOAN_SOURCE=real          # PennyMac Loan Services API
# DATA__SOP_SOURCE=local          # synthetic data/sops only
# DATA__SOP_SOURCE=confluence     # Confluence SOPs only
# DATA__SOP_SOURCE=both           # synthetic + Confluence
# DATA__SOP_CONFLUENCE_MODE=cache # read data/sops/_confluence (offline)
# DATA__SOP_CONFLUENCE_MODE=live  # fetch Confluence REST + refresh cache
# Demo mix (fixtures + Confluence-only cache):
DATA__LOAN_SOURCE=mock
DATA__SOP_SOURCE=confluence
DATA__SOP_CONFLUENCE_MODE=cache
# Deprecated unified switch (loan_source; real → sop both+live):
