EMBEDDING__PROVIDER=gemini
EMBEDDING__GEMINI__API_KEY=<your-google-ai-api-key>
EMBEDDING__GEMINI__MODEL=text-embedding-004

# Doc GraphRAG P4/P5 — community summary routing (default off; wrap DocsService when enabled)
# GRAPHRAG__ENABLED=false
# GRAPHRAG__ARTIFACT_DIR=data/graphrag

# Agent orchestration engine (ADR-031): langgraph | native | mock
# AGENT_RUNTIME__PROVIDER=langgraph
# Build communities: uv run python -m packages.graph_rag.build
# P5 LLM extract (pinned LLM__*): uv run python -m packages.graph_rag.build --extract

# API operation index and doc search use Postgres + pgvector (same shape as Plaisse wiki).
VECTOR_STORE__PROVIDER=pgvector
# VECTOR_STORE__PGVECTOR_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/loanops
# VECTOR_STORE__PGVECTOR_DIMENSIONS=384
# VECTOR_STORE__PROVIDER=ai_search
# VECTOR_STORE__AI_SEARCH__ENDPOINT=https://<resource>.search.windows.net
# VECTOR_STORE__AI_SEARCH__INDEX=sops

PII__PROVIDER=presidio

SAFETY__PROVIDER=stub
# SAFETY__PROVIDER=azure
# SAFETY__AZURE__ENDPOINT=https://<resource>.cognitiveservices.azure.com

AUDIT__SINK=jsonl
AUDIT__JSONL__DIR=./audit
# AUDIT__SINK=appinsights
# AUDIT__APPINSIGHTS__CONNECTION_STRING=InstrumentationKey=...

SECRETS__PROVIDER=env
# SECRETS__PROVIDER=keyvault
# SECRETS__KEYVAULT__URI=https://<vault>.vault.azure.net

TELEMETRY__PROVIDER=console
# TELEMETRY__PROVIDER=appinsights
# TELEMETRY__APPINSIGHTS__CONNECTION_STRING=InstrumentationKey=...
# Self-hosted Langfuse — no Docker required. Same Postgres server as LoanOps;
# separate DB name `langfuse` (do not use `loanops` schema):
#   psql -U postgres -h localhost -c "CREATE DATABASE langfuse;"
#   Run Langfuse natively with DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langfuse
#   UI http://localhost:3000 (not Langfuse Cloud)
# TELEMETRY__PROVIDER=langfuse
# TELEMETRY__LANGFUSE__PUBLIC_KEY=pk-lf-local
# TELEMETRY__LANGFUSE__SECRET_KEY=sk-lf-local
# TELEMETRY__LANGFUSE__HOST=http://localhost:3000
# TELEMETRY__LANGFUSE__ENVIRONMENT=local
# Leave TELEMETRY__PROVIDER=console if Langfuse is not running locally.
# Optional Docker recipe only: docker-compose.langfuse.yml

# EvalStore (ADR-032) — L7/L8/L9. Default jsonl = zero Langfuse credentials.
EVAL_STORE__PROVIDER=jsonl
EVAL_STORE__JSONL_DIR=./out/eval_store
# EVAL_STORE__PROVIDER=langfuse  # reuses TELEMETRY__LANGFUSE__*

TOOLS_CLIENT__PROVIDER=mcp
# TOOLS_CLIENT__PROVIDER=modular   # single-process rollback; no MCP hop (make demo without :8001)
# Roles: system | user | dev | pm | customer  (care_rep = deprecated alias of user)
AGENT_ROLE=system

# Streamable HTTP MCP listener (python -m packages.mcp_server). Required when TOOLS_CLIENT__PROVIDER=mcp.
# MCP__HOST=127.0.0.1
# MCP__PORT=8001
# MCP__PATH=/mcp
# MCP__AUTH_TOKEN=
# MCP__ROLE=system
# MCP__PRINCIPAL_USER=   # optional; forwarded as x-loanops-user on call_sse_api
# MCP__PRINCIPAL_TENANT= # optional; forwarded as x-loanops-tenant

# RDF Capability Knowledge Graph (ADR-014). Product truth = EAKG shards (D4).
# CAPABILITY_KG__ENABLED=true
# CAPABILITY_KG__NAMESPACE=https://loanops.local/ontology/
# CAPABILITY_KG__APPROVED_ONLY=false
# CAPABILITY_KG__SEMANTIC=false  # Phase 9: true = NL rank via data/eakg/enterprise/embeddings.json (run: python -m packages.eakg embed); embedder must match sidecar dims
# CAPABILITY_KG__REQUIRE_CAPABILITY_BIND=false  # true = call_sse_api must pass capability_id
# CAPABILITY_KG__ENFORCE_PERMISSIONS=false  # true = requiresPermission checked at MCP
# CAPABILITY_KG__ALLOWED_PERMISSIONS=[]  # empty = role defaults (system/dev: loan.read)
# ADR-026: EAKG runtime is HTTP SPARQL (GraphDB Free local; Neptune RDF later).
# GRAPH_STORE__QUERY_URL=http://localhost:7200/repositories/loanops
# GRAPH_STORE__UPDATE_URL=http://localhost:7200/repositories/loanops/statements
# GRAPH_STORE__AUTH_TOKEN=
# GRAPH_STORE__AUTH_MODE=none   # none | bearer | sigv4 (Neptune product)
# GRAPH_STORE__REGION=          # empty → LLM__BEDROCK__REGION when auth_mode=sigv4
# GRAPH_STORE__TIMEOUT_SECONDS=30
# AWS product (from terraform output):
# GRAPH_STORE__QUERY_URL=https://<neptune-endpoint>:8182/sparql
# GRAPH_STORE__UPDATE_URL=https://<neptune-endpoint>:8182/sparql
# GRAPH_STORE__AUTH_MODE=sigv4
# Workbench viz: http://localhost:7200 (data dir outside this repo).
# One-time cutover: uv run python -m packages.eakg graph-load
#
# ADR-027: product = Postgres (+ GraphDB + pgvector). No S3. No repo file truth.
EAKG_STORE__BACKEND=postgres
# EAKG_STORE__DSN=   # empty → VECTOR_STORE__PGVECTOR_DSN
# File mode (tests/offline): mirrors under data/pipeline_store/{GraphDb,Postgres,Pgvector}
# EAKG_STORE__BACKEND=file
# EAKG_STORE__FILE_SHARD_DIR=data/pipeline_store
# Migrate: uv run python -m packages.eakg artifacts migrate-from-disk
# Set CAPABILITY_KG__ENABLED=false to turn graph discovery off without code changes.
# Enterprise Application Knowledge Graph (ADR-015..019)
# EAKG__WORKSPACE_DIR=.eakg-workspace
# EAKG__REGISTRY_PATH=data/eakg/registry/repositories.yaml
# EAKG__SHARD_DIR=data/eakg  # legacy; file mode uses EAKG_STORE__FILE_SHARD_DIR
# EAKG__GITLAB_HOST=gitlab.pnmac.com
# EAKG__OPENAPI_MODE=hybrid
# EAKG__LIVE_SPEC_TOKEN=
# EAKG__CONFIDENCE_THRESHOLD=0.85
# EAKG__AUTO_APPROVE_STRUCTURAL=true
# EAKG__NIGHTLY_HOUR=2
# EAKG__REVIEW_STALE_DAYS=14
# EAKG__TAAC_FIXTURE_PATH=data/eakg/fixtures/taac-client-config.redacted.json
# EAKG__EXTRACTOR=auto  # auto|roslyn|regex — Roslyn primary (D5); regex interim fallback
# EAKG__ENGINEERING_GRAPH=true  # Graphify AST → Postgres/engineering/<id>/ (file) or tempfile→DB
# Active environment for the registry catalog (local|dev|stage|prod).
EAKG__ENVIRONMENT=local
# EAKG__TAAC_CONFIG_PATH=

# API index — two-stage vector search over unified operations (ADR-024).
# Off by default: search_sse_apis keeps the sidecar/keyword path until enabled.
# API_INDEX__ENABLED=false
# API_INDEX__NAMESPACE_PREFIX=api_ops
# API_INDEX__APP_SHORTLIST_SIZE=5
# Phase 5: API_INDEX__STALE_AFTER_HOURS=48
# Phase 5: API_INDEX__SCHEDULER_ENABLED=false

# Per-app credentials (P4). Shared SSE__API_KEY only for listed app ids.
# CREDENTIALS__PROVIDER=static
# CREDENTIALS__STATIC_SHARED_APPS=[]
# Per-app secrets via SecretsProvider: APP_TOKEN_<APPID>
# Plaisse M2M with PNMAC requested_destination (per registry base_url):
# CREDENTIALS__PROVIDER=auth0_m2m
# CREDENTIALS__AUTH0_DOMAIN=auth.dev.pennymac.plaisse.com
# CREDENTIALS__AUTH0_CLIENT_ID=
# CREDENTIALS__AUTH0_CLIENT_SECRET=
# CREDENTIALS__AUTH0_AUDIENCE=https://pennymac

# SSE OpenAPI — sole answer path.
# registry = catalog from the EAKG registry (enterprise-app-scale). auto falls
# back to swagger_links, then a registry with a cached spec, then the fixture.
SSE__CATALOG_SOURCE=registry
# Kept for the legacy fixture path. Does not override SSE__CATALOG_SOURCE.
SSE__USE_FIXTURE=true
SSE__API_BASE_URL=https://corecomponentsapi.dev.pennymac.plaisse.com
# SSE__API_KEY=
# D7: SubservicingClient Auth0 M2M Bearer (audience https://pennymac).
# Refresh (manual): .\scripts\auth\refresh-sse-m2m.ps1
# Optional probe: .\scripts\auth\refresh-sse-m2m.ps1 -ProbeUrl "https://loanservicesapi-plaisse-dev.pnmac.com/api/Loans/1000002245/Summary"
# Secret lives in SubservicingClient user-secrets (Auth0M2M:ClientSecret). Do not commit.
# SSE__USE_FIXTURE=false
# SSE__SWAGGER_LINKS=[{"id":"pennedocs","label":"PennEDocs","url":"https://pennedocsapi.dev.pennymac.plaisse.com/swagger/v1/swagger.json"},{"id":"corecomponents","label":"CoreComponents","url":"https://corecomponentsapi.dev.pennymac.plaisse.com/swagger/v1/swagger.json"}]
# SSE__SWAGGER_URLS=["https://pennedocsapi.dev.pennymac.plaisse.com/swagger/v1/swagger.json"]

# SQL Server (packages.db) — needs ODBC Driver 18 + aioodbc when fixture_mode=false
SQL_SERVER__FIXTURE_MODE=true
# SQL_SERVER__SERVER=
# SQL_SERVER__DATABASE=
# SQL_SERVER__USER=
# SQL_SERVER__PASSWORD=

# Session store: memory (default) or postgres (durable wiki-style threads)
SESSION_STORE__PROVIDER=memory

PROMPT_STORE__PROVIDER=file
PROMPT_STORE__FILE__BASE_DIR=./docs
# PROMPT_STORE__PROVIDER=promptflow
# PROMPT_STORE__PROMPTFLOW__WORKSPACE=<workspace>

# RERANKER__PROVIDER=sentence_transformers
# RERANKER__MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Loan + SOP source (independent switches) ───────────────────────────────
# DATA__LOAN_SOURCE=mock          # fixtures (data/fixtures/loan_api) or data/loans.json
# DATA__LOAN_SOURCE=real          # PennyMac Loan Services API
# DATA__SOP_SOURCE=local          # synthetic data/sops only
# DATA__SOP_SOURCE=confluence     # Confluence SOPs only
# DATA__SOP_SOURCE=both           # synthetic + Confluence
# DATA__SOP_CONFLUENCE_MODE=cache # offline: Postgres/sop_page_cache (file mode)
# DATA__SOP_CONFLUENCE_MODE=live  # product: Confluence REST → pgvector docs
# Product SOP path:
DATA__LOAN_SOURCE=mock
DATA__SOP_SOURCE=confluence
DATA__SOP_CONFLUENCE_MODE=live
# Deprecated unified switch (loan_source; real → sop both+live):
# DATA__MODE=mock
