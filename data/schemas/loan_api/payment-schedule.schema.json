{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payment-schedule.schema.json",
  "title": "LoanServices PaymentSchedules response",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "PaymentScheduleId",
      "LoanId",
      "NextPaymentDueDate",
      "PaymentDueMonth",
      "TotalPaymentAmount",
      "PendingEscrowPaymentAmount",
      "MonthlyPaymentPrincipalAmount",
      "MonthlyPaymentInterestAmount"
    ],
    "properties": {
      "PaymentScheduleId": { "type": "integer" },
      "LoanId": { "type": "integer" },
      "NextPaymentDueDate": { "type": "string", "format": "date-time" },
      "PaymentDueMonth": { "type": "string", "format": "date-time" },
      "TotalPaymentAmount": { "type": "number" },
      "PendingEscrowPaymentAmount": { "type": "number" },
      "InterestRate": { "type": "number" },
      "MonthlyPaymentAmount": { "type": "number" },
      "MonthlyPaymentPrincipalAmount": { "type": "number" },
      "MonthlyPaymentInterestAmount": { "type": "number" },
      "MonthlyCountyTaxAmount": { "type": "number" },
      "MonthlyHazardInsuranceAmount": { "type": "number" },
      "QuotedLateChargeFeeAmount": { "type": "number" },
      "LateChargeGraceEndDate": { "type": ["string", "null"], "format": "date-time" }
    },
    "additionalProperties": true
  }
}
