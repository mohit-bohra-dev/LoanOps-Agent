{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "borrower-item.schema.json",
  "title": "LoanServices Borrower Summary Item",
  "type": "object",
  "required": [
    "BorrowerId",
    "LoanId",
    "BorrowerOrdinal",
    "BorrowerFirstName",
    "BorrowerLastName"
  ],
  "properties": {
    "BorrowerId": { "type": "integer" },
    "LoanId": { "type": "integer" },
    "BorrowerOrdinal": { "type": "integer", "minimum": 1 },
    "BorrowerFirstName": { "type": "string", "minLength": 1 },
    "BorrowerLastName": { "type": "string", "minLength": 1 },
    "BorrowerMiddleName": { "type": "string" },
    "BorrowerUnparsedName": { "type": "string" },
    "BorrowerMailingLocality": { "type": "string" },
    "BorrowerMailingRegion": { "type": "string", "minLength": 2, "maxLength": 2 },
    "BorrowerMailingPostalCode": { "type": "string" },
    "BorrowerEmailAddress": { "type": "string", "format": "email" },
    "BorrowerPrimaryPhoneNumber": { "type": "string" },
    "ObligorFlag": { "type": "boolean" }
  },
  "additionalProperties": true
}
