{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loan-summary.schema.json",
  "title": "LoanServices Loan Summary",
  "type": "object",
  "required": [
    "LoanId",
    "LoanActiveFlag",
    "EscrowFlag",
    "UnpaidPrincipalBalanceAmount",
    "NextPaymentDueDate",
    "LastPaymentReceivedDate",
    "CurrentInterestRate",
    "CurrentMonthlyPaymentAmount",
    "CurrentEscrowMonthlyPaymentAmount",
    "CurrentTotalMonthlyPaymentAmount",
    "MortgageTypeDescription",
    "PropertyRegion",
    "LoanMaturityDate",
    "InvestorName",
    "DelinquentPaymentCount",
    "PaidOffFlag",
    "ChargedOffFlag"
  ],
  "properties": {
    "LoanId": { "type": "integer" },
    "LoanActiveFlag": { "type": "boolean" },
    "EscrowFlag": { "type": "boolean" },
    "PaidOffFlag": { "type": "boolean" },
    "ChargedOffFlag": { "type": "boolean" },
    "UnpaidPrincipalBalanceAmount": { "type": "number" },
    "NextPaymentDueDate": { "type": ["string", "null"], "format": "date-time" },
    "LastPaymentReceivedDate": { "type": ["string", "null"], "format": "date-time" },
    "CurrentInterestRate": { "type": "number" },
    "CurrentMonthlyPaymentAmount": { "type": "number" },
    "CurrentEscrowMonthlyPaymentAmount": { "type": "number" },
    "CurrentTotalMonthlyPaymentAmount": { "type": "number" },
    "MortgageTypeDescription": { "type": "string" },
    "PropertyRegion": { "type": "string", "minLength": 2, "maxLength": 2 },
    "MailingRegion": { "type": "string", "minLength": 2, "maxLength": 2 },
    "LoanMaturityDate": { "type": ["string", "null"], "format": "date-time" },
    "InvestorName": { "type": "string" },
    "DelinquentPaymentCount": { "type": "integer", "minimum": 0 },
    "DelinquentAtBoardingFlag": { "type": "boolean" },
    "LossMitigationTemplateDescription": { "type": ["string", "null"] },
    "ForeclosureStatusDescription": { "type": ["string", "null"] },
    "BankruptcyStatusDescription": { "type": ["string", "null"] },
    "EscrowBalanceAmount": { "type": "number" },
    "LastEscrowAnalysisDate": { "type": ["string", "null"], "format": "date-time" },
    "MonthlyCountyTaxAmount": { "type": "number" },
    "MonthlyHazardInsuranceAmount": { "type": "number" },
    "MonthlyMortgageInsuranceAmount": { "type": "number" },
    "MonthlyOverageShortageAmount": { "type": "number" },
    "PaymentScheduleDueMonth": { "type": ["string", "null"], "format": "date-time" },
    "BorrowerSummary": {
      "type": "array",
      "items": { "$ref": "borrower-item.schema.json" }
    }
  },
  "additionalProperties": true
}
