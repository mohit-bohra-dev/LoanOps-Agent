<mxCell id="confluence" value="Confluence&lt;br&gt;SOP pages" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;shape=mxgraph.aws4.traditional_server;" vertex="1" parent="1"><mxGeometry x="3000" y="1220" width="78" height="78" as="geometry"/></mxCell>
