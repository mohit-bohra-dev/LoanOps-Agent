{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Layer2: Agent API :8000",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "apps.agent_api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Layer2: MCP server :8001",
      "type": "debugpy",
      "request": "launch",
      "module": "packages.mcp_server",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Web UI (Vite dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/web_ui"
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${file}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Layer2: Flow A (modular — Agent only)",
      "configurations": ["Layer2: Agent API :8000"],
      "stopAll": true
    },
    {
      "name": "Layer2: Flow B (mcp hop — Agent + MCP)",
      "configurations": [
        "Layer2: MCP server :8001",
        "Layer2: Agent API :8000"
      ],
      "stopAll": true
    },
    {
      "name": "Layer2: Flow C (Cursor — MCP only)",
      "configurations": ["Layer2: MCP server :8001"],
      "stopAll": true
    }
  ]
}
